    "/api/jlpt-voca/search": {
      "get": {
        "description": "레벨별 단어 목록 조회 및 검색 (search, word, meaning, meaning_ko)",
        "operationId": "JlptVocaController_list",
        "parameters": [
          {
            "name": "level",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 200,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "word",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meaning",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meaning_ko",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "onlyMeta",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JlptVocaListResponseDto"
                }
              }
            }
          }
        },
        "summary": "JLPT 단어 목록 조회",
        "tags": [
          "JLPT Vocabulary"
        ]
      }
    },
    "/api/jlpt-voca/totals-by-level": {
      "get": {
        "description": "JLPT 레벨별 전체 단어 수와 전체 합계를 반환",
        "operationId": "JlptVocaController_levelsMeta",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JlptVocaLevelsMetaResponseDto"
                }
              }
            }
          }
        },
        "summary": "레벨 메타 정보 조회",
        "tags": [
          "JLPT Vocabulary"
        ]
      }
    },
    "/api/jlpt-voca/random/level": {
      "get": {
        "description": "레벨 별 또는 전체에서 지정한 개수만큼 랜덤 단어 조회",
        "operationId": "JlptVocaController_randomByLevel",
        "parameters": [
          {
            "name": "level",
            "required": false,
            "in": "query",
            "description": "JLPT 레벨 (미지정 시 전체 레벨에서 조회)",
            "schema": {
              "example": "1",
              "type": "string"
            }
          },
          {
            "name": "count",
            "required": false,
            "in": "query",
            "description": "조회할 단어 개수 (최대 50)",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 1,
              "example": 3,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JlptVocaResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "레벨 기반 랜덤 단어 조회",
        "tags": [
          "JLPT Vocabulary"
        ]
      }
    },
    "/api/jlpt-voca/random/ids": {
      "get": {
        "description": "쿼리로 전달된 ID 배열에 해당하는 단어들을 랜덤으로 섞어서 반환",
        "operationId": "JlptVocaController_randomByIds",
        "parameters": [
          {
            "name": "ids",
            "required": false,
            "in": "query",
            "description": "조회할 단어 ID 배열",
            "schema": {
              "example": [
                1,
                2,
                3
              ],
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JlptVocaResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "ID 배열 기반 단어 랜덤 섞기",
        "tags": [
          "JLPT Vocabulary"
        ]
      }
    },
    "/api/jlpt-voca/find": {
      "get": {
        "description": "word 필드가 정확히 일치하는 단어 조회",
        "operationId": "JlptVocaController_findByWordExact",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JlptVocaResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "일치하는 단어가 없습니다."
          }
        },
        "summary": "단어 정확히 일치 검색",
        "tags": [
          "JLPT Vocabulary"
        ]
      }
    },
    "/api/jlpt-voca/examples": {
      "post": {
        "description": "일본어 단어를 입력받아 OpenAI 에이전트를 통해 예문과 한자별 후리가나 매핑을 생성합니다.",
        "operationId": "JlptVocaController_createExampleSentence",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateExampleSentenceDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleSentenceResponseDto"
                }
              }
            }
          }
        },
        "summary": "OpenAI 예문 및 후리가나 생성",
        "tags": [
          "JLPT Vocabulary"
        ]
      }
    },
    "/api/geo/coordinates": {
      "get": {
        "description": "도로명 또는 지번 주소를 전달하면 TMAP Full Address Geo API를 호출하여 좌표 정보를 반환합니다.",
        "operationId": "GeoController_lookupCoordinates",
        "parameters": [
          {
            "name": "address",
            "required": true,
            "in": "query",
            "description": "도로명 또는 지번 주소",
            "schema": {
              "example": "서울특별시 성동구 동원북로22번길 8",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "TMAP 도로명/지번 주소 좌표 조회",
        "tags": [
          "Geo"
        ]
      }
    },
    "/api/geo/transit/routes": {
      "post": {
        "description": "TMAP Transit Routes API를 호출하여 출발지-도착지 기준 대중교통 경로를 조회합니다.",
        "operationId": "GeoController_getTransitRoutes",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetTransitRoutesDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "대중교통 경로 탐색",
        "tags": [
          "Geo"
        ]
      }
    },
    "/api/study-insights": {
      "post": {
        "operationId": "StudyInsightsController_createInsight",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStudyInsightDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyInsightResponseDto"
                }
              }
            }
          }
        },
        "summary": "현재 학습 상태 AI 분석",
        "tags": [
          "Study Insights"
        ]
      }
    }
  },
  "info": {
    "title": "JLPT Vocabulary API",
    "description": "JLPT 단어 학습을 위한 API 문서",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "인증 관련 API (회원가입, 로그인, 로그아웃)"
    },
    {
      "name": "Profiles",
      "description": "사용자 프로필 관리 API"
    },
    {
      "name": "JLPT Vocabulary",
      "description": "JLPT 단어 조회 및 검색 API"
    },
    {
      "name": "Study Insights",
      "description": "AI 학습 상태 분석 API"
    },
    {
      "name": "Geo",
      "description": "지오코딩 및 대중교통 경로 API"
    },
    {
      "name": "Health",
      "description": "서버 상태 확인 API"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AiLocationDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 37.5665
          },
          "lng": {
            "type": "number",
            "example": 126.978
          }
        }
      },
      "AiStatusResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "received"
          }
        },
        "required": [
          "status"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "7a5a3df3-b70a-47fb-9672-3eb1cc6a92db"
          },
          "email": {
            "type": "string",
            "example": "learner@example.com",
            "format": "email"
          },
          "role": {
            "type": "string",
            "example": "authenticated"
          },
          "aud": {
            "type": "string",
            "example": "authenticated"
          },
          "app_metadata": {
            "type": "object",
            "additionalProperties": true,
            "example": {}
          },
          "user_metadata": {
            "type": "object",
            "additionalProperties": true,
            "example": {}
          },
          "created_at": {
            "type": "string",
            "example": "2026-09-03T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "aud",
          "app_metadata",
          "user_metadata",
          "created_at"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Supabase access token"
          },
          "refresh_token": {
            "type": "string",
            "description": "Supabase refresh token"
          },
          "token_type": {
            "type": "string",
            "example": "bearer"
          },
          "expires_in": {
            "type": "number",
            "example": 3600
          },
          "expires_at": {
            "type": "number",
            "example": 1788436800
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponseDto"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "user"
        ]
      },
      "SignUpResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthUserResponseDto"
              }
            ]
          },
          "session": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthSessionResponseDto"
              }
            ]
          },
          "message": {
            "type": "string",
            "example": "회원가입이 완료되었습니다."
          }
        },
        "required": [
          "user",
          "session",
          "message"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignInResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponseDto"
          },
          "session": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthSessionResponseDto"
              }
            ]
          },
          "access_token": {
            "type": "string",
            "nullable": true
          },
          "refresh_token": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "example": "로그인이 완료되었습니다."
          }
        },
        "required": [
          "user",
          "session",
          "access_token",
          "refresh_token",
          "message"
        ]
      },
      "CurrentUserResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponseDto"
          },
          "message": {
            "type": "string",
            "example": "현재 사용자 정보를 조회했습니다."
          }
        },
        "required": [
          "user",
          "message"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "로그아웃이 완료되었습니다."
          }
        },
        "required": [
          "message"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "7a5a3df3-b70a-47fb-9672-3eb1cc6a92db"
          },
          "username": {
            "type": "string",
            "nullable": true,
            "example": "dadok"
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "다독이"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "example": "https://example.com/avatar.png"
          },
          "createdAt": {
            "type": "string",
            "nullable": true,
            "example": "2026-09-03T12:00:00.000Z",
